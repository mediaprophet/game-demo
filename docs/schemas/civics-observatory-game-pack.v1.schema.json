{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civics.au/schemas/game/civics-observatory-game-pack-1.json",
  "title": "Civics Observatory game data pack manifest",
  "description": "Provisional game-side envelope for provenance-bearing source artifacts. Payload syntax and semantics remain owned by their source systems.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_type", "manifest_version", "package_id", "created_at", "registry_uri", "development_project_uris", "sources"],
  "properties": {
    "manifest_type": { "const": "civics-observatory-game-pack" },
    "manifest_version": { "const": 1 },
    "package_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "registry_uri": { "type": "string", "format": "uri" },
    "development_project_uris": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "publisher", "source_uri", "snapshot_at", "update_cadence", "licence", "access", "maturity", "geography", "uncertainty", "privacy_review", "prohibited_inferences", "artifacts"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{2,255}$" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "uri"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "uri": { "type": "string", "format": "uri" }
          }
        },
        "source_uri": { "type": "string", "format": "uri" },
        "release": { "type": ["string", "null"] },
        "snapshot_at": { "type": "string", "format": "date-time" },
        "update_cadence": { "type": "string", "minLength": 1 },
        "licence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statement", "uri", "attribution", "redistribution"],
          "properties": {
            "statement": { "type": "string", "minLength": 1 },
            "uri": { "type": ["string", "null"], "format": "uri" },
            "attribution": { "type": "string", "minLength": 1 },
            "redistribution": { "enum": ["permitted", "conditional", "prohibited", "unknown"] }
          }
        },
        "access": { "enum": ["public_download", "public_api_snapshot", "public_reference_only", "restricted", "synthetic_demo", "other"] },
        "maturity": { "enum": ["observed", "prepared_public_context", "reviewed_evidence", "preliminary_model", "concept_reference", "synthetic_demo", "other"] },
        "geography": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "crs", "time_period"],
          "properties": {
            "scope": { "type": "string", "minLength": 1 },
            "crs": { "type": ["string", "null"] },
            "time_period": { "type": ["string", "null"] },
            "bounds": { "type": ["array", "null"], "minItems": 4, "maxItems": 4, "items": { "type": "number" } }
          }
        },
        "vocabulary_versions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "description"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "code_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "uncertainty": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "privacy_review": { "enum": ["not_assessed", "reviewed_no_personal_data", "review_required", "restricted"] },
        "prohibited_inferences": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "role", "path", "format", "sha256"],
            "properties": {
              "artifact_id": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\]+$", "not": { "pattern": "(^|/)\\.\\.?(/|$)" } },
              "format": { "type": "string", "minLength": 1 },
              "media_type": { "type": ["string", "null"] },
              "encoding": { "type": ["string", "null"] },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  }
}
