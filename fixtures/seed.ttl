# Maslows Challenge — first-playable seed world.
# Kestrel Flats: a fictional town. One triple per line (token form); the
# session strips @prefix/comments — gates match on raw lexical tokens.
@prefix rc: <https://game.example/rc#> .
@prefix ev: <https://game.example/ev#> .

rc:player a rc:Resident .
rc:world rc:contentVersion 5 .
rc:player rc:atPlace rc:camp .
rc:player rc:coin rc:c01 .
rc:player rc:coin rc:c02 .
rc:player rc:coin rc:c03 .
rc:player rc:coin rc:c04 .
rc:player rc:coin rc:c05 .
rc:player rc:coin rc:c06 .
rc:player rc:coin rc:c07 .
rc:player rc:coin rc:c08 .
rc:player rc:coin rc:c09 .
rc:player rc:coin rc:c10 .
rc:player rc:coin rc:c11 .
rc:player rc:coin rc:c12 .
rc:player rc:labourToken rc:l0 .
rc:community a rc:Community .
rc:community rc:status "building" .

rc:camp a rc:Place .
rc:camp rc:name "Kestrel Flats camp" .
rc:swag a rc:Shelter .
rc:swag rc:atPlace rc:camp .
rc:swag rc:owner rc:player .

rc:workshop a rc:Workshop .
rc:workshop rc:name "Community workshop" .
rc:workshop rc:status "offline" .
rc:workshop rc:powerWatts 0 .
rc:communicationsMast a rc:Relay .
rc:communicationsMast rc:name "Kestrel communications mast" .
rc:communicationsMast rc:status "offline" .

rc:solarProject a rc:CommunityProject .
rc:solarProject rc:name "Workshop solar upgrade" .
rc:solarProject rc:forFacility rc:workshop .
rc:solarProject rc:targetWatts 400 .
rc:solarProject rc:hasApplication rc:grantApplication .
rc:grantApplication a rc:FundingApplication .
rc:grantApplication rc:forProject rc:solarProject .
rc:solarProject rc:designDocumentsFrom rc:player .
rc:solarProject rc:technicalKnowledgeHeldBy rc:player .
rc:player rc:holdsTechnicalKnowledge rc:solarIntegration .
rc:solarIntegration a rc:TechnicalKnowledge .
rc:solarIntegration rc:requiredFor rc:solarProject .

rc:market a rc:Market .
rc:market rc:sells rc:partPanel .
rc:market rc:sells rc:partInverter .
rc:partPanel a rc:Part .
rc:partPanel rc:coinCost 4 .
rc:partInverter a rc:Part .
rc:partInverter rc:coinCost 7 .

rc:scrapyard a rc:Place .
rc:scrapyard rc:name "Old railway scrapyard" .
rc:scrapyard rc:mayYield rc:partPanel .
rc:scrapyard rc:mayYield rc:partInverter .

rc:committee a rc:Committee .
rc:committee rc:governs rc:solarProject .
rc:committee rc:chair rc:committeeChair .
rc:committeeChair a rc:CommitteeMember .
rc:committeeChair rc:associate rc:chairAssociate .
rc:chairAssociate a rc:Contractor .
rc:committeeChair rc:decisionMakerFor rc:committee .
rc:community rc:resident rc:residentMara .
rc:community rc:resident rc:residentEli .
rc:community rc:resident rc:residentJon .
rc:residentMara a rc:CommunityMember .
rc:residentEli a rc:CommunityMember .
rc:residentJon a rc:CommunityMember .

rc:waterTank a rc:WaterTank .
rc:waterTank rc:name "Shared water tank" .
rc:waterTank rc:status "offline" .
rc:waterTank rc:waterLitres 0 .
rc:garden a rc:Garden .
rc:garden rc:name "Community garden" .
rc:garden rc:status "dry" .
rc:garden rc:usesWaterFrom rc:waterTank .

# Saltwind Reach: a connected second territory, with projects that depend on
# the first town's restored water and power rather than a separate rule stack.
rc:saltwindReach a rc:Territory .
rc:saltwindReach rc:name "Saltwind Reach" .
rc:bridge a rc:Bridge .
rc:bridge rc:connects rc:camp .
rc:bridge rc:connects rc:saltwindReach .
rc:bridge rc:status "broken" .
rc:windPump a rc:Pump .
rc:windPump rc:status "offline" .
rc:windPump rc:atPlace rc:saltwindReach .
rc:orchard a rc:Orchard .
rc:orchard rc:status "dry" .
rc:orchard rc:usesWaterFrom rc:windPump .

# Opening history deliberately keeps the contributor's initiative, claims
# against them, and current institutional treatment as separate facts.
rc:playerHistory a rc:PlayerHistory .
rc:playerHistory rc:about rc:player .
rc:player rc:housingStatus "unhoused" .
rc:player rc:sleepingAt rc:camp .
rc:player rc:reputationStanding "contested" .
rc:playerHistory rc:priorProject rc:waterCoop .
rc:waterCoop a rc:HistoricalProject .
rc:waterCoop rc:initiatedBy rc:player .
rc:waterCoop rc:respondedTo rc:unmetWaterNeed .
rc:waterCoop rc:initiallyUnfunded "true" .
rc:waterCoop rc:outcome "unsafe-hours-after-maintenance-lapse" .
rc:player rc:acceptsInitiativeResponsibility rc:waterCoop .
rc:maintenanceLapse rc:causedBy rc:fundingGap .
rc:maintenanceLapse rc:harmed rc:residentMara .
rc:maintenanceClaim a rc:Claim .
rc:maintenanceClaim rc:assertedBy rc:committeeChair .
rc:maintenanceClaim rc:about rc:player .
rc:maintenanceClaim rc:status "disputed" .
rc:playerHistory rc:repairAttempt rc:unfunded .
rc:playerHistory rc:claimAgainstContributor rc:committeeChair .
rc:committeeChair rc:conflictOfInterest rc:currentSolarProject .
rc:committeeChair rc:seeksControlOf rc:solarProject .
rc:committeeChair rc:seeksGrantFundsFor rc:solarProject .
rc:committeeChair rc:usesClaimFor rc:grantApplication .
rc:politicalBacker a rc:Contractor .
rc:politicalBacker rc:expectsFutureSupportFrom rc:committeeChair .
rc:playerHistory rc:currentPlansReusedBy rc:committee .
rc:committee rc:usesPlansFrom rc:player .
rc:playerHistory rc:remedyStatus "not-yet-documented" .
rc:policeOfficer a rc:InstitutionalActor .
rc:policeOfficer rc:worksWith rc:committeeChair .
rc:publicWorksDepartment a rc:GovernmentAgency .
rc:publicWorksDepartment rc:responsibleFor rc:solarProject .
